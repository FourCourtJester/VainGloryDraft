{
  "name": "vainglory-draft",
  "version": "0.0.1",
  "private": true,
  "description": "A drafting engine: pick, ban and veto for any game, defined by data packs.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit",
    "dev": "npm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "build": "vite build --config client/vite.config.ts client",
    "dev:client": "vite --config client/vite.config.ts client",
    "ui-check": "node scripts/ui-check.mjs",
    "import-catalog": "node scripts/import-catalog.mjs",
    "import-portraits": "node scripts/import-portraits.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260902.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.128.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
